{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-sandbox.ai/schemas/trajectory-benchmark/trajectory-1.0.json",
  "title": "Normalized Code Agent Trajectory",
  "type": "object",
  "required": ["schema_version", "task_id", "metadata", "trajectory"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "trajectory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "action", "observation", "source"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "action": {
            "type": "object",
            "required": ["tool", "arguments"],
            "properties": {
              "tool": {
                "enum": ["command_run", "file_read", "list_directory", "file_write", "file_replace_contents", "file_insert"]
              },
              "arguments": {"type": "object"}
            },
            "additionalProperties": false
          },
          "observation": {"type": "string"},
          "source": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
