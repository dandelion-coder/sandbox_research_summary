{
  "cases": [
    {
      "name": "file_read_small",
      "call": {
        "tool": "file_read",
        "arguments": {
          "path": "/workspace/django/django/utils/text.py"
        }
      }
    },
    {
      "name": "file_read_large",
      "call": {
        "tool": "file_read",
        "arguments": {
          "path": "/workspace/django/django/db/models/sql/query.py"
        }
      }
    },
    {
      "name": "file_search_exact",
      "call": {
        "tool": "file_search",
        "arguments": {
          "path": "/workspace/django",
          "pattern": "**/query.py"
        }
      }
    },
    {
      "name": "file_search_glob",
      "call": {
        "tool": "file_search",
        "arguments": {
          "path": "/workspace/django",
          "pattern": "**/*query*.py"
        }
      }
    },
    {
      "name": "file_write",
      "setup": [
        {
          "tool": "command_run",
          "arguments": {
            "command": "mkdir -p /workspace/.opensandbox_benchmark"
          }
        }
      ],
      "call": {
        "tool": "file_write",
        "arguments": {
          "path": "/workspace/.opensandbox_benchmark/bench-write-{invocation}.txt",
          "content": "OPEN_SANDBOX_BENCH_WRITE_PAYLOAD_0123456789"
        }
      },
      "teardown": [
        {
          "tool": "file_delete",
          "arguments": {
            "paths": [
              "/workspace/.opensandbox_benchmark/bench-write-{invocation}.txt"
            ]
          }
        }
      ]
    },
    {
      "name": "file_replace_contents",
      "setup": [
        {
          "tool": "command_run",
          "arguments": {
            "command": "mkdir -p /workspace/.opensandbox_benchmark"
          }
        },
        {
          "tool": "file_write",
          "arguments": {
            "path": "/workspace/.opensandbox_benchmark/bench-replace-{invocation}.txt",
            "content": "OPEN_SANDBOX_BENCH_ORIGINAL"
          }
        }
      ],
      "call": {
        "tool": "file_replace_contents",
        "arguments": {
          "entries": [
            {
              "path": "/workspace/.opensandbox_benchmark/bench-replace-{invocation}.txt",
              "old_content": "OPEN_SANDBOX_BENCH_ORIGINAL",
              "new_content": "OPEN_SANDBOX_BENCH_REPLACED"
            }
          ]
        }
      },
      "teardown": [
        {
          "tool": "file_delete",
          "arguments": {
            "paths": [
              "/workspace/.opensandbox_benchmark/bench-replace-{invocation}.txt"
            ]
          }
        }
      ]
    },
    {
      "name": "command_pwd",
      "call": {
        "tool": "command_run",
        "arguments": {
          "command": "pwd",
          "working_directory": "/workspace/django"
        }
      }
    },
    {
      "name": "command_ls",
      "call": {
        "tool": "command_run",
        "arguments": {
          "command": "ls",
          "working_directory": "/workspace/django"
        }
      }
    },
    {
      "name": "command_grep_recursive",
      "call": {
        "tool": "command_run",
        "arguments": {
          "command": "grep -R -n \"FilteredRelation\" django",
          "working_directory": "/workspace/django"
        }
      }
    },
    {
      "name": "command_git_status_short",
      "call": {
        "tool": "command_run",
        "arguments": {
          "command": "git status --short",
          "working_directory": "/workspace/django"
        }
      }
    }
  ]
}
